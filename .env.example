# network: mainnet only (owner's decision). Local tests never use these.
SOLANA_RPC_URL=
RPC_WEBHOOK_SECRET=
SAMITE_PROGRAM_ID=                 # after the owner deploys (M5)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v   # TODO(verify) against Circle before M5
KEEPER_SECRET=                     # base58; fees only, no authority
KEEPER_ENABLED=false
INDEXER_POLL_MS=                   # worker: ms between RPC checks, 1000–20000 (default 2000; 5000 fits Helius free)
# storage
DATABASE_URL=
UPSTASH_REDIS_REST_URL=            # optional: without these two, rate limits and replay keys live in Postgres (kv)
UPSTASH_REDIS_REST_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SESSION_SECRET=
# moderation
ANTHROPIC_API_KEY=
MODERATION_MODEL=
# public
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_RPC_URL=               # browser RPC: a rate-limited, read-only provider key
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_TOKEN_CA=              # empty = no token chip anywhere
NEXT_PUBLIC_TOKEN_TICKER=
NEXT_PUBLIC_PRIVY_APP_ID=          # Privy app (wallets only); empty = the app's own Wallet Standard dialog
